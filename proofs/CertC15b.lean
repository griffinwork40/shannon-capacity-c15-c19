/-- The sizes at tail node `n16`. -/
def sn16 : Sizes := tailW Substitutions.S3g sn5 s1 s1 19

/-- Tail node `n16` has the sizes `sn16` (by the tail induction `w_tailIter`). -/
lemma wn16 (R : Realisation Letter Letter.sep G) (h : ∀ a, R.w a = w0 a) (a : Letter) :
    (Rn16 R).w a = sn16.get a :=
  (w_castR _ _ a).trans
    (w_tailIter Substitutions.S3g (Rn5 R) (R1 R) (R1 R) sn5 s1 s1
      (fun b => wn5 R h b) (fun b => w1 R h b) (fun b => w1 R h b) 19 a)

/-! ### Node `n17` = `S3g(n5, R1, n16)`, exponent `149` -/

/-- The child exponents of node `n17`. -/
def en17 : Fin 3 → Nat := Fin.cases 55 (Fin.cases 1 (fun _ => 93))

/-- The children of node `n17`. -/
def chn17 (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (en17 i)) :=
  Fin.cases (Rn5 R) (Fin.cases (R1 R) (fun _ => (Rn16 R)))

/-- Node `n17`. -/
def Rn17 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 149) :=
  Realisation.multiSubst en17 (chn17 R) Substitutions.S3g

/-- The sizes at node `n17`. -/
def sn17 : Sizes := node3 Substitutions.S3g sn5 s1 sn16

/-- Node `n17` has the sizes `sn17`. -/
lemma wn17 (R : Realisation Letter Letter.sep G) (h : ∀ a, R.w a = w0 a) (a : Letter) :
    (Rn17 R).w a = sn17.get a :=
  w_node3 Substitutions.S3g (chn17 R) sn5 s1 sn16
    (fun b => wn5 R h b) (fun b => w1 R h b) (fun b => wn16 R h b) a

/-! ### Node `n18` = `S3g(n17, n7, R1)`, exponent `169` -/

/-- The child exponents of node `n18`. -/
def en18 : Fin 3 → Nat := Fin.cases 149 (Fin.cases 19 (fun _ => 1))

/-- The children of node `n18`. -/
def chn18 (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (en18 i)) :=
