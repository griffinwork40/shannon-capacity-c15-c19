    (fun b => wn8 R h b) (fun b => w1 R h b) (fun b => wn17 R h b) a

/-! ### The bound -/

/-- `M` is the size of the terminal code on the four terminal nodes. -/
theorem stepM : M = code4 K sn11 sn15 sn18 sn19 := by
  native_decide

/-- The exponents of the 4 terminal children. -/
def eT : Fin 4 → Nat := Fin.cases 314 (Fin.cases 147 (Fin.cases 169 (fun _ => 226)))

/-- The terminal children. -/
def terminalChildren (R : Realisation Letter Letter.sep G) :
    (i : Fin 4) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (eT i)) :=
  Fin.cases (Rn11 R) (Fin.cases (Rn15 R) (Fin.cases (Rn18 R) (fun _ => (Rn19 R))))

/-- **The bound.**  A port system whose seven families have the sizes of `w0` gives an
independent set of size `M` in `G^(box 856)`. -/
theorem bound (S : RichPortSystem G) (hw : ∀ a, (S.fam a).card = w0 a) :
    M ≤ (SimpleGraph.strongPower G 856).indepNum := by
  have h : ∀ a, S.toRealisation.w a = w0 a := hw
  have hc := sum_code4 K (terminalChildren S.toRealisation) sn11 sn15 sn18 sn19
    (fun b => wn11 S.toRealisation h b) (fun b => wn15 S.toRealisation h b) (fun b => wn18 S.toRealisation h b) (fun b => wn19 S.toRealisation h b)
  exact le_trans (le_of_eq (stepM.trans hc.symm))
    (le_indepNum_multiCode eT (terminalChildren S.toRealisation) K)

