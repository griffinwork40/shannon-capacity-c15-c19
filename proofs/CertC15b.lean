/-! ### Node `n19` = `S3g(n8, R1, n17)`, exponent `226` -/

/-- The child exponents of node `n19`. -/
def en19 : Fin 3 → Nat := Fin.cases 76 (Fin.cases 1 (fun _ => 149))

/-- The children of node `n19`. -/
def chn19 (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (en19 i)) :=
  Fin.cases (Rn8 R) (Fin.cases (R1 R) (fun _ => (Rn17 R)))

/-- Node `n19`. -/
def Rn19 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 226) :=
